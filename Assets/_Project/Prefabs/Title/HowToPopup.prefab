  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>\uC2A4\uD1A0\uB9AC</b>\n\uD1F4\uC9C1\uAE08\uC73C\uB85C \uC791\uC740 \uBCA0\uC774\uCEE4\uB9AC \uCE74\uD398\uB97C \uC5F0 \uC8FC\uC778\uACF5.\n\uD558\uC9C0\uB9CC \uD574\uC678 \uC804\uC7C1\uC73C\uB85C \uC8FC\uC2DD\uC774 \uD3ED\uB77D\uD558\uBA74\uC11C \uC790\uAE08\uC774 \uBC14\uB2E5\uB098 \uBC84\uB838\uC2B5\uB2C8\uB2E4.\n\uC8FC\uC2DD\uC744 \uD314\uC9C0 \uC54A\uACE0 \uBC84\uD2F0\uB824\uBA74, \uCE74\uD398 \uB9E4\uCD9C\uB9CC\uC73C\uB85C \uB9E4\uC77C \uC784\uB300\uB8CC\uB97C \uB0B4\uC57C \uD569\uB2C8\uB2E4.\n\n<b>\uC9C4\uD589 \uADDC\uCE59</b>\n15\uC77C \uB3D9\uC548 \uB9E4\uC77C \uC784\uB300\uB8CC\uB97C \uB0B4\uBA70 \uCE74\uD398\uB97C \uC6B4\uC601\uD558\uC138\uC694.\n\uC784\uB300\uB8CC\uB97C \uB0B4\uC9C0 \uBABB\uD558\uBA74 \uCE74\uD398\uB294 \uBB38\uC744 \uB2EB\uAC8C \uB429\uB2C8\uB2E4.\n\n<b>\uD558\uB8E8\uC758 \uD750\uB984</b>\n\uC624\uD508 \uC900\uBE44  \u2192  \uC8FC\uBB38 \uBC1B\uAE30  \u2192  \uC74C\uB8CC \uC81C\uC870 \uBC0F \uB9E4\uC7A5 \uC6B4\uC601  \u2192  \uD558\uB8E8 \uC815\uC0B0"
